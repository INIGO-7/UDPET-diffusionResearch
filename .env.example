# Copia este fichero a .env y rellena los valores. .env está gitignored.
# NUNCA pongas tokens reales aquí: este fichero SÍ se trackea en git.

# Repo privado de Hugging Face Datasets con los shards del tar + splits.json.
HF_DATASET_REPO=usuario/nombre-dataset

# Token de HF con acceso de lectura al repo privado (https://huggingface.co/settings/tokens)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Rama del proyecto a clonar (por defecto master).
REPO_BRANCH=master

# Pon a 1 para probar el build sin descargar los 60 GB del dataset.
SKIP_DATASET=1

# Pon a 1 para reinstalar requirements.txt del repo clonado al arrancar.
SYNC_DEPS=0
